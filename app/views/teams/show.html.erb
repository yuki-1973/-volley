<div style="max-width: 800px; margin: 40px auto; padding: 20px; font-family: sans-serif;">
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #333; padding-bottom: 10px;">
    <h2>🏐 <%= @team.name %></h2>
    <div>
      <%= link_to "⚔️ 試合一覧・登録", team_matches_path(@team), style: "background: #17a2b8; color: white; padding: 8px 14px; text-decoration: none; border-radius: 6px; font-weight: bold; margin-right: 8px;" %>
      <%= link_to "✏️ 編集", edit_team_path(@team), style: "background: #ffc107; color: #333; padding: 8px 14px; text-decoration: none; border-radius: 6px; font-weight: bold; margin-right: 8px;" %>
      <%= link_to "🗑️ 削除", team_path(@team), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, style: "background: #dc3545; color: white; padding: 8px 14px; text-decoration: none; border-radius: 6px; font-weight: bold;" %>
    </div>
  </div>

  <div style="margin-top: 15px;">
    <%= link_to "← チーム一覧に戻る", teams_path, style: "color: #007bff; text-decoration: none;" %>
  </div>

  <h3 style="margin-top: 30px;">📋 選手名簿</h3>
  <table style="width: 100%; border-collapse: collapse; margin-top: 10px;">
    <thead>
      <tr style="background: #f4f4f4; text-align: left;">
        <th style="padding: 8px; border: 1px solid #ccc;">区分</th>
        <th style="padding: 8px; border: 1px solid #ccc;">背番号</th>
        <th style="padding: 8px; border: 1px solid #ccc;">氏名</th>
        <th style="padding: 8px; border: 1px solid #ccc;">ポジション</th>
      </tr>
    </thead>
    <tbody>
      <% @team.players.each do |player| %>
        <% if player.name.present? %>
          <tr>
            <td style="padding: 8px; border: 1px solid #ccc;"><%= player.starter? ? "★ スタメン" : "控え" %></td>
            <td style="padding: 8px; border: 1px solid #ccc;"><%= player.number %></td>
            <td style="padding: 8px; border: 1px solid #ccc;"><%= player.name %></td>
            <td style="padding: 8px; border: 1px solid #ccc;"><%= player.position %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>

<% current_set = params[:set_number].present? ? params[:set_number].to_i : 1 %>
<% starters = @team.players.where(is_starter: true) %>
<% if starters.empty? %>
  <% starters = @team.players.first(8) %>
<% end %>

<div style="max-width: 1200px; margin: 10px auto; padding: 10px; font-family: sans-serif; user-select: none;">
  <!-- ヘッダー情報 -->
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #333; padding-bottom: 8px;">
    <h2 style="margin: 0; font-size: 1.3em;">🏐 <%= @team.name %> vs <%= @match.opponent_name %></h2>
    <div>
      <%= link_to "← 試合一覧", team_matches_path(@team), style: "color: #007bff; text-decoration: none; margin-right: 15px; font-weight: bold;" %>
      <span style="font-size: 0.9em; color: #666;"><%= @match.match_date %></span>
    </div>
  </div>

  <!-- セット切替タブ -->
  <div style="margin: 10px 0; display: flex; gap: 8px;">
    <% (1..@match.total_sets).each do |s| %>
      <%= link_to "第 #{s} セット", team_match_path(@team, @match, set_number: s), style: "padding: 6px 14px; border-radius: 4px; text-decoration: none; font-weight: bold; #{s == current_set ? 'background: #007bff; color: white;' : 'background: #e9ecef; color: #333;'}" %>
    <% end %>
  </div>

  <!-- 2. メイン入力画面レイアウト (左: 選手 / 中央: コート / 右: 評価ボタン) -->
  <div style="display: grid; grid-template-columns: 180px 1fr 180px; gap: 10px; align-items: start; background: #222; padding: 15px; border-radius: 10px; color: white;">
    
    <!-- 左側: スタメン（6〜8名）ボタン配列 -->
    <div style="display: flex; flex-direction: column; gap: 8px;">
      <div style="font-size: 0.85em; font-weight: bold; text-align: center; color: #aaa;">コート内選手 (長押しで交代)</div>
      <% starters.each_with_index do |player, idx| %>
        <button type="button" class="player-btn" data-player-id="<%= player.id %>" data-player-name="#<%= player.number %> <%= player.name %>" 
                onclick="selectPlayer(this)" oncontextmenu="openSubstitutionModal(<%= player.id %>, '<%= player.name %>'); return false;"
                style="padding: 12px 8px; background: #444; color: white; border: 2px solid #666; border-radius: 8px; font-weight: bold; text-align: left; cursor: pointer;">
          #<%= player.number %> <%= player.name %>
          <span style="font-size: 0.75em; display: block; color: #ccc;"><%= player.position %></span>
        </button>
      <% end %>
      <button type="button" onclick="selectPlayer(null)" style="padding: 8px; background: #666; color: white; border: none; border-radius: 6px; cursor: pointer; margin-top: 5px;">選択解除</button>
    </div>

    <!-- 中央: バレーボールコートマップ -->
    <div style="text-align: center;">
      <!-- 相手サーブエリア -->
      <div id="opp_serve_area" onclick="selectZone('相手サーブエリア')" style="background: #444; color: #ffeb3b; padding: 8px; margin-bottom: 5px; border-radius: 4px; cursor: pointer; font-size: 0.85em; font-weight: bold;">
        ▲ 相手サーブエリア (タップでレセプション始点)
      </div>

      <div id="court_canvas" onclick="handleCourtTap(event)" style="position: relative; width: 100%; max-width: 380px; height: 420px; background: #d97724; border: 4px solid white; margin: 0 auto; border-radius: 4px; cursor: crosshair;">
        <!-- ネット -->
        <div style="position: absolute; top: 50%; width: 100%; height: 6px; background: #fff; transform: translateY(-50%); box-shadow: 0 0 4px rgba(0,0,0,0.5);"></div>
        <div style="position: absolute; top: 48%; width: 100%; text-align: center; color: rgba(255,255,255,0.8); font-size: 0.7em; pointer-events: none;">--- NET ---</div>
        
        <!-- フロントゾーンライン (自チーム) -->
        <div id="front_zone" style="position: absolute; bottom: 33%; width: 100%; height: 2px; background: rgba(255,255,255,0.6); pointer-events: none;"></div>
        
        <!-- テキスト表示 -->
        <div style="position: absolute; top: 20%; width: 100%; color: rgba(255,255,255,0.4); font-weight: bold; pointer-events: none;">相手コート</div>
        <div style="position: absolute; bottom: 20%; width: 100%; color: rgba(255,255,255,0.4); font-weight: bold; pointer-events: none;">自チームコート</div>
      </div>

      <!-- 自チームサーブエリア -->
      <div id="own_serve_area" onclick="selectZone('自チームサーブエリア')" style="background: #444; color: #ffeb3b; padding: 8px; margin-top: 5px; border-radius: 4px; cursor: pointer; font-size: 0.85em; font-weight: bold;">
        ▼ 自チームエンドライン (タップでサーブ始点)
      </div>

      <!-- 操作ステータス案内バー -->
      <div id="status_bar" style="margin-top: 8px; background: #333; padding: 8px; border-radius: 4px; color: #00e676; font-size: 0.85em; font-weight: bold;">
        選択中: なし (操作手順: ゾーン/選手 → コース/結果タップ)
      </div>
    </div>

    <!-- 右側: 判定ボタン（◎ / ◯ / △ / ✖️） -->
    <div style="display: flex; flex-direction: column; gap: 10px;">
      <div style="font-size: 0.85em; font-weight: bold; text-align: center; color: #aaa;">評価・結果決定</div>

      <button type="button" onclick="submitLog('◎', '得点/成功')" style="padding: 15px; background: #28a745; color: white; border: none; border-radius: 8px; font-size: 1.1em; font-weight: bold; cursor: pointer;">
        ◎ 得点/成功
        <span style="display: block; font-size: 0.65em; font-weight: normal; margin-top: 2px;">スパイク決定/Aカット/エース</span>
      </button>

      <button type="button" onclick="submitLog('◯', '継続/普通')" style="padding: 15px; background: #17a2b8; color: white; border: none; border-radius: 8px; font-size: 1.1em; font-weight: bold; cursor: pointer;">
        ◯ 継続/普通
        <span style="display: block; font-size: 0.65em; font-weight: normal; margin-top: 2px;">スパイクラリー/Bカット</span>
      </button>

      <button type="button" onclick="submitLog('△', '効果薄/乱れ')" style="padding: 15px; background: #ffc107; color: #222; border: none; border-radius: 8px; font-size: 1.1em; font-weight: bold; cursor: pointer;">
        △ 乱れる
        <span style="display: block; font-size: 0.65em; font-weight: normal; margin-top: 2px;">カット乱れ/サーブ被Aカット</span>
      </button>

      <button type="button" onclick="submitLog('✖️', 'ミス/失点')" style="padding: 15px; background: #dc3545; color: white; border: none; border-radius: 8px; font-size: 1.1em; font-weight: bold; cursor: pointer;">
        ✖️ ミス/失点
        <span style="display: block; font-size: 0.65em; font-weight: normal; margin-top: 2px;">スパイクミス/カットミス/サーブミス</span>
      </button>
    </div>
  </div>

  <!-- 送信用隠しフォーム -->
  <%= form_with model: [@team, @match, PlayLog.new], local: true, id: "play_log_form" do |f| %>
    <%= f.hidden_field :set_number, value: current_set %>
    <%= f.hidden_field :player_id, id: "form_player_id" %>
    <%= f.hidden_field :action_type, id: "form_action_type" %>
    <%= f.hidden_field :eval_detail, id: "form_eval_detail" %>
    <%= f.hidden_field :result, id: "form_result" %>
    <%= f.hidden_field :start_x, id: "form_start_x" %>
    <%= f.hidden_field :start_y, id: "form_start_y" %>
    <%= f.hidden_field :end_x, id: "form_end_x" %>
    <%= f.hidden_field :end_y, id: "form_end_y" %>
  <% end %>

  <!-- 3. 📊 データ分析画面 (選手別スタッツ集計表) -->
  <div style="margin-top: 35px; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <h3 style="margin-top: 0; border-bottom: 2px solid #007bff; padding-bottom: 8px; color: #333;">📊 選手別スタッツ・分析データ (第 <%= current_set %> セット)</h3>
    <table style="width: 100%; border-collapse: collapse; margin-top: 10px; text-align: center;">
      <thead>
        <tr style="background: #007bff; color: white;">
          <th style="padding: 10px; border: 1px solid #ddd; text-align: left;">選手名</th>
          <th style="padding: 10px; border: 1px solid #ddd;">① サーブ効果率</th>
          <th style="padding: 10px; border: 1px solid #ddd;">② スパイク決定率</th>
          <th style="padding: 10px; border: 1px solid #ddd;">③ レセプション成功率</th>
          <th style="padding: 10px; border: 1px solid #ddd;">④ ブロック決定数</th>
        </tr>
      </thead>
      <tbody>
        <% @team.players.where.not(name: [nil, ""]).each do |player| %>
          <% p_logs = @match.play_logs.where(set_number: current_set, player_id: player.id) %>
          <% 
            # サーブ計算
            s_logs = p_logs.where(action_type: "サーブ")
            s_total = s_logs.count
            s_rate = s_total > 0 ? (((s_logs.where(eval_detail: "◎").count * 100.0) + (s_logs.where(eval_detail: "◯").count * 25.0) - (s_logs.where(eval_detail: "✖️").count * 25.0)) / s_total) : 0.0

            # スパイク計算
            k_logs = p_logs.where(action_type: "スパイク")
            k_total = k_logs.count
            k_rate = k_total > 0 ? ((k_logs.where(eval_detail: "◎").count.to_f / k_total) * 100.0) : 0.0

            # レセプション計算
            r_logs = p_logs.where(action_type: "レセプション")
            r_total = r_logs.count
            r_rate = r_total > 0 ? (((r_logs.where(eval_detail: "◎").count * 100.0) + (r_logs.where(eval_detail: "◯").count * 50.0)) / r_total) : 0.0

            # ブロック得点
            b_kills = p_logs.where(action_type: "ブロック", eval_detail: "◎").count
          %>
          <% if p_logs.any? || player.is_starter? %>
            <tr style="border-bottom: 1px solid #eee;">
              <td style="padding: 10px; border: 1px solid #ddd; text-align: left; font-weight: bold;">
                #<%= player.number %> <%= player.name %> <span style="font-size: 0.8em; color: #666;">(<%= player.position %>)</span>
              </td>
              <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; color: #007bff;"><%= sprintf("%.1f", s_rate) %>% <span style="font-size: 0.75em; color: #888;">(<%= s_total %>本)</span></td>
              <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; color: #28a745;"><%= sprintf("%.1f", k_rate) %>% <span style="font-size: 0.75em; color: #888;">(<%= k_total %>本)</span></td>
              <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; color: #6f42c1;"><%= sprintf("%.1f", r_rate) %>% <span style="font-size: 0.75em; color: #888;">(<%= r_total %>本)</span></td>
              <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; color: #fd7e14; font-size: 1.1em;"><%= b_kills %> 本</td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<script>
  let selectedPlayerId = null;
  let selectedZone = null;
  let tapPoints = [];

  function selectPlayer(btn) {
    document.querySelectorAll('.player-btn').forEach(b => b.style.borderColor = '#666');
    if (btn) {
      selectedPlayerId = btn.getAttribute('data-player-id');
      btn.style.borderColor = '#00e676';
      updateStatus("選手選択: " + btn.getAttribute('data-player-name'));
    } else {
      selectedPlayerId = null;
      updateStatus("選手選択を解除しました");
    }
  }

  function selectZone(zoneName) {
    selectedZone = zoneName;
    updateStatus("ゾーン選択: " + zoneName);
  }

  function handleCourtTap(e) {
    const rect = e.currentTarget.getBoundingClientRect();
    const x = (((e.clientX - rect.left) / rect.width) * 100).toFixed(1);
    const y = (((e.clientY - rect.top) / rect.height) * 100).toFixed(1);

    tapPoints.push({ x: x, y: y });

    if (tapPoints.length === 1) {
      updateStatus("起点選択: (X:" + x + "%, Y:" + y + "%) → 次に終点をタップ");
    } else if (tapPoints.length === 2) {
      updateStatus("コース選択完了！右側の評価ボタン(◎ ◯ △ ✖️)をタップしてください");
    }
  }

  function updateStatus(msg) {
    document.getElementById('status_bar').innerText = msg;
  }

  function submitLog(evalSymbol, resultStr) {
    let actionType = "スパイク";

    if (selectedZone === "自チームサーブエリア") {
      actionType = "サーブ";
    } else if (selectedZone === "相手サーブエリア") {
      actionType = "レセプション";
    } else if (tapPoints.length > 0 && tapPoints[0].y > 50 && tapPoints[0].y < 67) {
      actionType = "ブロック";
    }

    document.getElementById('form_player_id').value = selectedPlayerId;
    document.getElementById('form_action_type').value = actionType;
    document.getElementById('form_eval_detail').value = evalSymbol;
    document.getElementById('form_result').value = resultStr;

    if (tapPoints.length >= 1) {
      document.getElementById('form_start_x').value = tapPoints[0].x;
      document.getElementById('form_start_y').value = tapPoints[0].y;
    }
    if (tapPoints.length >= 2) {
      document.getElementById('form_end_x').value = tapPoints[1].x;
      document.getElementById('form_end_y').value = tapPoints[1].y;
    }

    document.getElementById('play_log_form').submit();
  }

  function openSubstitutionModal(playerId, playerName) {
    if (confirm(playerName + " 選手を控え選手と交代しますか？")) {
      alert("交代機能呼び出し");
    }
  }
</script>

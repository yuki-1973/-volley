<% current_set = params[:set_number].present? ? params[:set_number].to_i : 1 %>
<% starters = @team.players.where(is_starter: true) %>
<% if starters.empty? %>
  <% starters = @team.players.first(8) %>
<% end %>

<div style="max-width: 1100px; margin: 10px auto; padding: 10px; font-family: sans-serif; user-select: none;">
  <!-- ヘッダー情報 -->
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #333; padding-bottom: 8px;">
    <h2 style="margin: 0; font-size: 1.2em;">🏐 <%= @team.name %> vs <%= @match.opponent_name %></h2>
    <div>
      <%= link_to "← 試合一覧", team_matches_path(@team), style: "color: #007bff; text-decoration: none; margin-right: 15px; font-weight: bold; font-size: 0.9em;" %>
      <span style="font-size: 0.85em; color: #666;"><%= @match.match_date %></span>
    </div>
  </div>

  <!-- セット切替タブ -->
  <div style="margin: 10px 0; display: flex; gap: 8px;">
    <% (1..@match.total_sets).each do |s| %>
      <%= link_to "第 #{s} セット", team_match_path(@team, @match, set_number: s), style: "padding: 6px 14px; border-radius: 4px; text-decoration: none; font-weight: bold; font-size: 0.9em; #{s == current_set ? 'background: #007bff; color: white;' : 'background: #e9ecef; color: #333;'}" %>
    <% end %>
  </div>

  <!-- 2. メイン入力画面レイアウト (左: コンパクト選手ボタン / 中央: コート / 右: コンパクト記号ボタン) -->
  <div style="display: grid; grid-template-columns: 80px 1fr 70px; gap: 10px; align-items: center; background: #222; padding: 12px; border-radius: 10px; color: white;">
    
    <!-- 左側: コンパクト背番号ボタン配列 (ポジション別カラー、#なし) -->
    <div style="display: flex; flex-direction: column; gap: 6px; align-items: center;">
      <div style="font-size: 0.7em; font-weight: bold; text-align: center; color: #aaa;">コート</div>
      <% starters.each do |player| %>
        <%
          bg_color = case player.position
                     when "S"  then "#ffeb3b"
                     when "L"  then "#28a745"
                     when "W"  then "#ffffff"
                     when "M"  then "#6c757d"
                     when "OP" then "#fd7e14"
                     else "#aaaaaa"
                     end
          text_color = ["S", "W"].include?(player.position) ? "#222222" : "#ffffff"
        %>
        <button type="button" class="player-btn" data-player-id="<%= player.id %>" data-player-name="<%= player.number %> <%= player.name %>" 
                onclick="selectPlayer(this)" oncontextmenu="openSubstitutionModal(<%= player.id %>, '<%= player.name %>'); return false;"
                title="<%= player.number %> <%= player.name %> (<%= player.position %>)"
                style="width: 55px; height: 38px; background: <%= bg_color %>; color: <%= text_color %>; border: 3px solid transparent; border-radius: 6px; font-weight: bold; font-size: 1.1em; cursor: pointer; display: flex; align-items: center; justify-content: center;">
          <%= player.number %>
        </button>
      <% end %>
      <button type="button" onclick="selectPlayer(null)" style="width: 55px; padding: 4px; background: #555; color: white; border: none; border-radius: 4px; font-size: 0.65em; cursor: pointer; margin-top: 2px;">解除</button>
    </div>

    <!-- 中央: バレーボールコートマップ -->
    <div style="text-align: center;">
      <!-- 相手サーブエリア -->
      <div id="opp_serve_area" onclick="selectZone('相手サーブエリア')" style="background: #444; color: #ffeb3b; padding: 6px; margin-bottom: 4px; border-radius: 4px; cursor: pointer; font-size: 0.8em; font-weight: bold;">
        ▲ 相手サーブエリア (タップでレセプション始点)
      </div>

      <div id="court_canvas" onclick="handleCourtTap(event)" style="position: relative; width: 100%; max-width: 340px; height: 380px; background: #d97724; border: 3px solid white; margin: 0 auto; border-radius: 4px; cursor: crosshair;">
        <!-- ネット -->
        <div style="position: absolute; top: 50%; width: 100%; height: 5px; background: #fff; transform: translateY(-50%); box-shadow: 0 0 4px rgba(0,0,0,0.5);"></div>
        <div style="position: absolute; top: 48%; width: 100%; text-align: center; color: rgba(255,255,255,0.8); font-size: 0.65em; pointer-events: none;">--- NET ---</div>
        
        <!-- フロントゾーンライン (自チーム) -->
        <div id="front_zone" style="position: absolute; bottom: 33%; width: 100%; height: 2px; background: rgba(255,255,255,0.6); pointer-events: none;"></div>
        
        <!-- テキスト表示 -->
        <div style="position: absolute; top: 20%; width: 100%; color: rgba(255,255,255,0.4); font-weight: bold; pointer-events: none; font-size: 0.85em;">相手コート</div>
        <div style="position: absolute; bottom: 20%; width: 100%; color: rgba(255,255,255,0.4); font-weight: bold; pointer-events: none; font-size: 0.85em;">自チームコート</div>
      </div>

      <!-- 自チームサーブエリア -->
      <div id="own_serve_area" onclick="selectZone('自チームサーブエリア')" style="background: #444; color: #ffeb3b; padding: 6px; margin-top: 4px; border-radius: 4px; cursor: pointer; font-size: 0.8em; font-weight: bold;">
        ▼ 自チームエンドライン (タップでサーブ始点)
      </div>

      <!-- 操作ステータス案内バー -->
      <div id="status_bar" style="margin-top: 6px; background: #333; padding: 6px; border-radius: 4px; color: #00e676; font-size: 0.8em; font-weight: bold;">
        選択中: なし (ゾーン/選手 → コース/結果タップ)
      </div>
    </div>

    <!-- 右側: コンパクト記号ボタン（◎ / ◯ / △ / ✖️） -->
    <div style="display: flex; flex-direction: column; gap: 8px; align-items: center;">
      <div style="font-size: 0.7em; font-weight: bold; text-align: center; color: #aaa;">評価</div>

      <button type="button" onclick="submitLog('◎', '得点/成功')" style="width: 50px; height: 50px; background: #28a745; color: white; border: none; border-radius: 8px; font-size: 1.5em; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center;">
        ◎
      </button>

      <button type="button" onclick="submitLog('◯', '継続/普通')" style="width: 50px; height: 50px; background: #17a2b8; color: white; border: none; border-radius: 8px; font-size: 1.5em; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center;">
        ◯
      </button>

      <button type="button" onclick="submitLog('△', '効果薄/乱れ')" style="width: 50px; height: 50px; background: #ffc107; color: #222; border: none; border-radius: 8px; font-size: 1.5em; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center;">
        △
      </button>

      <button type="button" onclick="submitLog('✖️', 'ミス/失点')" style="width: 50px; height: 50px; background: #dc3545; color: white; border: none; border-radius: 8px; font-size: 1.5em; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center;">
        ✖️
      </button>
    </div>
  </div>

  <!-- 送信用隠しフォーム -->
  <%= form_with model: [@team, @match, PlayLog.new], local: true, id: "play_log_form" do |f| %>
    <%= f.hidden_field :set_number, value: current_set %>
    <%= f.hidden_field :player_id, id: "form_player_id" %>
    <%= f.hidden_field :action_type, id: "form_action_type" %>
    <%= f.hidden_field :eval_detail, id: "form_eval_detail" %>
    <%= f.hidden_field :result, id: "form_result" %>
    <%= f.hidden_field :start_x, id: "form_start_x" %>
    <%= f.hidden_field :start_y, id: "form_start_y" %>
    <%= f.hidden_field :end_x, id: "form_end_x" %>
    <%= f.hidden_field :end_y, id: "form_end_y" %>
  <% end %>

  <!-- 3. 📊 データ分析画面 (選手別スタッツ集計表) -->
  <div style="margin-top: 25px; background: white; padding: 15px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <h3 style="margin-top: 0; border-bottom: 2px solid #007bff; padding-bottom: 6px; color: #333; font-size: 1.1em;">📊 選手別スタッツ・分析データ (第 <%= current_set %> セット)</h3>
    <table style="width: 100%; border-collapse: collapse; margin-top: 8px; text-align: center; font-size: 0.9em;">
      <thead>
        <tr style="background: #007bff; color: white;">
          <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">選手名</th>
          <th style="padding: 8px; border: 1px solid #ddd;">① サーブ効果率</th>
          <th style="padding: 8px; border: 1px solid #ddd;">② スパイク決定率</th>
          <th style="padding: 8px; border: 1px solid #ddd;">③ レセプション成功率</th>
          <th style="padding: 8px; border: 1px solid #ddd;">④ ブロック決定数</th>
        </tr>
      </thead>
      <tbody>
        <% @team.players.where.not(name: [nil, ""]).each do |player| %>
          <% p_logs = @match.play_logs.where(set_number: current_set, player_id: player.id) %>
          <% 
            s_logs = p_logs.where(action_type: "サーブ")
            s_total = s_logs.count
            s_rate = s_total > 0 ? (((s_logs.where(eval_detail: "◎").count * 100.0) + (s_logs.where(eval_detail: "◯").count * 25.0) - (s_logs.where(eval_detail: "✖️").count * 25.0)) / s_total) : 0.0

            k_logs = p_logs.where(action_type: "スパイク")
            k_total = k_logs.count
            k_rate = k_total > 0 ? ((k_logs.where(eval_detail: "◎").count.to_f / k_total) * 100.0) : 0.0

            r_logs = p_logs.where(action_type: "レセプション")
            r_total = r_logs.count
            r_rate = r_total > 0 ? (((r_logs.where(eval_detail: "◎").count * 100.0) + (r_logs.where(eval_detail: "◯").count * 50.0)) / r_total) : 0.0

            b_kills = p_logs.where(action_type: "ブロック", eval_detail: "◎").count
          %>
          <% if p_logs.any? || player.is_starter? %>
            <tr style="border-bottom: 1px solid #eee;">
              <td style="padding: 8px; border: 1px solid #ddd; text-align: left; font-weight: bold;">
                <%= player.number %> <%= player.name %> <span style="font-size: 0.8em; color: #666;">(<%= player.position %>)</span>
              </td>
              <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold; color: #007bff;"><%= sprintf("%.1f", s_rate) %>% <span style="font-size: 0.75em; color: #888;">(<%= s_total %>本)</span></td>
              <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold; color: #28a745;"><%= sprintf("%.1f", k_rate) %>% <span style="font-size: 0.75em; color: #888;">(<%= k_total %>本)</span></td>
              <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold; color: #6f42c1;"><%= sprintf("%.1f", r_rate) %>% <span style="font-size: 0.75em; color: #888;">(<%= r_total %>本)</span></td>
              <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold; color: #fd7e14; font-size: 1.1em;"><%= b_kills %> 本</td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<script>
  let selectedPlayerId = null;
  let selectedZone = null;
  let tapPoints = [];

  function selectPlayer(btn) {
    document.querySelectorAll('.player-btn').forEach(b => b.style.borderColor = 'transparent');
    if (btn) {
      selectedPlayerId = btn.getAttribute('data-player-id');
      btn.style.borderColor = '#00e676';
      updateStatus("選択: " + btn.getAttribute('data-player-name'));
    } else {
      selectedPlayerId = null;
      updateStatus("選択解除");
    }
  }

  function selectZone(zoneName) {
    selectedZone = zoneName;
    updateStatus("ゾーン: " + zoneName);
  }

  function handleCourtTap(e) {
    const rect = e.currentTarget.getBoundingClientRect();
    const x = (((e.clientX - rect.left) / rect.width) * 100).toFixed(1);
    const y = (((e.clientY - rect.top) / rect.height) * 100).toFixed(1);

    tapPoints.push({ x: x, y: y });

    if (tapPoints.length === 1) {
      updateStatus("起点: (X:" + x + "%, Y:" + y + "%) → 終点をタップ");
    } else if (tapPoints.length === 2) {
      updateStatus("コース選択完了 → 右側の結果ボタン(◎ ◯ △ ✖️)をタップ");
    }
  }

  function updateStatus(msg) {
    document.getElementById('status_bar').innerText = msg;
  }

  function submitLog(evalSymbol, resultStr) {
    let actionType = "スパイク";

    if (selectedZone === "自チームサーブエリア") {
      actionType = "サーブ";
    } else if (selectedZone === "相手サーブエリア") {
      actionType = "レセプション";
    } else if (tapPoints.length > 0 && tapPoints[0].y > 50 && tapPoints[0].y < 67) {
      actionType = "ブロック";
    }

    document.getElementById('form_player_id').value = selectedPlayerId;
    document.getElementById('form_action_type').value = actionType;
    document.getElementById('form_eval_detail').value = evalSymbol;
    document.getElementById('form_result').value = resultStr;

    if (tapPoints.length >= 1) {
      document.getElementById('form_start_x').value = tapPoints[0].x;
      document.getElementById('form_start_y').value = tapPoints[0].y;
    }
    if (tapPoints.length >= 2) {
      document.getElementById('form_end_x').value = tapPoints[1].x;
      document.getElementById('form_end_y').value = tapPoints[1].y;
    }

    document.getElementById('play_log_form').submit();
  }

  function openSubstitutionModal(playerId, playerName) {
    if (confirm(playerName + " 選手を交代しますか？")) {
      alert("交代機能呼び出し");
    }
  }
</script>

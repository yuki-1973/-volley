<div style="max-width: 800px; margin: 40px auto; padding: 20px; font-family: sans-serif;">
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #333; padding-bottom: 10px;">
    <h2>🏐 <%= @team.name %> vs <%= @match.opponent_name %></h2>
    <span style="color: #666;"><%= @match.match_date %></span>
  </div>

  <div style="margin-top: 15px;">
    <%= link_to "← 試合一覧に戻る", team_matches_path(@team), style: "color: #007bff; text-decoration: none;" %>
  </div>

  <div style="margin-top: 30px; background: #f9f9f9; padding: 20px; border-radius: 8px; border: 1px solid #ddd;">
    <h3>📝 プレイデータ入力画面</h3>
    <p style="color: #555;">試合の登録が完了しました！ここではサーブ、レシーブ、アタックなどのスタッツを記録していきます。</p>
  </div>
</div>

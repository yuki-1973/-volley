<% current_set = params[:set_number].present? ? params[:set_number].to_i : 1 %>
<% starters = @team.players.where(is_starter: true).limit(8) %>
<% if starters.empty? %>
  <% starters = @team.players.where.not(name: [nil, ""]).first(8) %>
<% end %>

<style>
  .court-wrapper {
    width: 100%;
    max-width: 280px;
    margin: 0 auto;
  }
  .court-canvas {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 2;
    background: #d97724;
    border: 3px solid white;
    border-radius: 4px;
    cursor: crosshair;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    box-sizing: border-box;
  }
  .player-btn {
    -webkit-touch-callout: none;
    user-select: none;
  }
  /* モーダル表示用スタイル */
  .modal-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.75);
    z-index: 9999;
    justify-content: center;
    align-items: center;
  }
  .modal-content {
    background: #222;
    color: white;
    padding: 15px;
    border-radius: 8px;
    width: 88%;
    max-width: 320px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.5);
    border: 1px solid #444;
  }
</style>

<div style="max-width: 1100px; margin: 5px auto; padding: 5px; font-family: sans-serif; user-select: none;">
  <!-- ヘッダー情報 -->
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #333; padding-bottom: 6px;">
    <h2 style="margin: 0; font-size: 1.1em;">🏐 <%= @team.name %> vs <%= @match.opponent_name %></h2>
    <div>
      <%= link_to "← 試合一覧", team_matches_path(@team), style: "color: #007bff; text-decoration: none; margin-right: 10px; font-weight: bold; font-size: 0.85em;" %>
      <span style="font-size: 0.8em; color: #666;"><%= @match.match_date %></span>
    </div>
  </div>

  <!-- セット切替タブ -->
  <div style="margin: 8px 0; display: flex; gap: 6px; overflow-x: auto;">
    <% (1..@match.total_sets).each do |s| %>
      <%= link_to "第 #{s} セット", team_match_path(@team, @match, set_number: s), style: "padding: 5px 12px; border-radius: 4px; text-decoration: none; font-weight: bold; font-size: 0.85em; white-space: nowrap; #{s == current_set ? 'background: #007bff; color: white;' : 'background: #e9ecef; color: #333;'}" %>
    <% end %>
  </div>

  <!-- メイン画面レイアウト -->
  <div id="main_input_container" style="display: grid; grid-template-columns: 75px 1fr; gap: 8px; align-items: start; background: #222; padding: 8px; border-radius: 8px; color: white;">
    
    <!-- 左側エリア: 選手ボタン表示エリア -->
    <div style="display: flex; flex-direction: column; gap: 5px; align-items: center; border-right: 1px solid #444; padding-right: 6px;">
      
      <div style="font-size: 0.6em; font-weight: bold; color: #aaa; text-align: center;">選手選択<br><span style="font-size: 0.8em; color: #888;">(長押し変更)</span></div>
      
      <!-- 動的に管理する選手ボタンコンテナ -->
      <div id="player_buttons_container" style="display: flex; flex-direction: column; gap: 5px; width: 100%; align-items: center;">
        <% starters.each_with_index do |player, idx| %>
          <%
            bg_color = case player.position
                       when "S"  then "#ffeb3b"
                       when "L"  then "#28a745"
                       when "W"  then "#ffffff"
                       when "M", "MB" then "#7bc043"
                       when "OP" then "#fd7e14"
                       else "#ffffff"
                       end
            text_color = ["S", "W"].include?(player.position) || bg_color == "#ffffff" ? "#222222" : "#ffffff"
          %>
          <button type="button" class="player-btn" id="starter_btn_<%= idx %>"
                  data-player-id="<%= player.id %>" 
                  data-player-number="<%= player.number %>"
                  data-player-name="<%= player.name %>"
                  data-player-pos="<%= player.position %>"
                  onclick="onPlayerClick(this)"
                  oncontextmenu="return false;"
                  title="<%= player.number %> <%= player.name %> (<%= player.position %>)"
                  style="width: 60px; height: 34px; background: <%= bg_color %>; color: <%= text_color %>; border: 3px solid transparent; border-radius: 5px; font-weight: bold; font-size: 0.95em; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s;">
            <%= player.number %>
          </button>
        <% end %>
      </div>

      <!-- 選手追加ボタン -->
      <button type="button" onclick="openAddPlayerModal()" style="width: 60px; padding: 4px 0; background: #007bff; color: white; border: none; border-radius: 4px; font-size: 0.7em; font-weight: bold; cursor: pointer; margin-top: 2px;">＋ 追加</button>
      <button type="button" onclick="resetPlayerFilter()" style="width: 60px; padding: 3px 0; background: #555; color: white; border: none; border-radius: 4px; font-size: 0.65em; cursor: pointer; margin-bottom: 4px;">全表示</button>

      <div style="width: 100%; border-bottom: 1px solid #555; margin: 2px 0;"></div>
      <div style="font-size: 0.65em; font-weight: bold; color: #aaa;">評価入力</div>

      <!-- 記録・評価ボタン -->
      <button type="button" class="record-btn" onclick="submitBlockKill()" style="width: 60px; height: 34px; background: #fd7e14; color: white; border: 1.5px solid #ffffff; border-radius: 5px; font-size: 0.75em; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center;">
        B決定
      </button>

      <button type="button" class="record-btn" onclick="submitLog('◎', '決定/成功')" style="width: 60px; height: 36px; background: #28a745; color: white; border: none; border-radius: 5px; font-size: 1.2em; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center;">
        ◎
      </button>

      <button type="button" class="record-btn" onclick="submitLog('◯', 'ラリー/普通')" style="width: 60px; height: 36px; background: #17a2b8; color: white; border: none; border-radius: 5px; font-size: 1.2em; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center;">
        ◯
      </button>

      <button type="button" class="record-btn" onclick="submitLog('△', '乱れ/効果薄')" style="width: 60px; height: 36px; background: #ffc107; color: #222; border: none; border-radius: 5px; font-size: 1.2em; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center;">
        △
      </button>

      <button type="button" class="record-btn" onclick="submitLog('✖️', 'ミス/失点')" style="width: 60px; height: 36px; background: #dc3545; color: white; border: none; border-radius: 5px; font-size: 1.2em; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center;">
        ✖️
      </button>

      <div style="width: 100%; border-bottom: 1px solid #555; margin: 2px 0;"></div>

      <!-- 修正/戻るボタン（フォーム入れ子防止修繕） -->
      <% last_log = @match.play_logs.where(set_number: current_set).last %>
      <% if last_log.present? %>
        <button type="button" onclick="deleteLastLog('<%= team_match_play_log_path(@team, @match, last_log) %>')" style="width: 60px; padding: 6px 0; background: #6c757d; color: white; border: none; border-radius: 5px; font-size: 0.7em; font-weight: bold; cursor: pointer; text-align: center;">↩ 戻る</button>
      <% else %>
        <button type="button" disabled style="width: 60px; padding: 6px 0; background: #444; color: #888; border: none; border-radius: 5px; font-size: 0.7em; font-weight: bold; cursor: not-allowed; text-align: center;">↩ 戻る</button>
      <% end %>

    </div>

    <!-- 右側エリア: コート表示 -->
    <div style="text-align: center; padding: 2px;">
      <div class="court-wrapper">
        <div id="opp_serve_area" onclick="selectZone('レセプション')" style="background: #444; color: #ffeb3b; padding: 6px; margin-bottom: 5px; border-radius: 4px; cursor: pointer; font-size: 0.75em; font-weight: bold; border: 2px solid transparent;">
          ▲ 相手サーブエリア (タップ)
        </div>

        <div id="court_canvas" class="court-canvas">
          <div style="position: absolute; top: 50%; width: 100%; height: 2px; background: white; pointer-events: none; transform: translateY(-50%); z-index: 2;"></div>
          <div style="position: absolute; top: 33.33%; width: 100%; height: 2px; background: rgba(255,255,255,0.6); pointer-events: none;"></div>
          <div style="position: absolute; bottom: 33.33%; width: 100%; height: 2px; background: rgba(255,255,255,0.6); pointer-events: none;"></div>
          
          <div style="position: absolute; top: 15%; width: 100%; color: rgba(255,255,255,0.4); font-weight: bold; pointer-events: none; font-size: 0.8em;">相手コート</div>
          <div style="position: absolute; bottom: 15%; width: 100%; color: rgba(255,255,255,0.4); font-weight: bold; pointer-events: none; font-size: 0.8em;">自チームコート</div>

          <svg id="arrow_svg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5; overflow: visible;">
            <defs>
              <marker id="arrow-white" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 0 L 10 5 L 0 10 z" fill="#ffffff" />
              </marker>
              <marker id="arrow-yellow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 0 L 10 5 L 0 10 z" fill="#ffeb3b" />
              </marker>
              <marker id="arrow-gray" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 0 L 10 5 L 0 10 z" fill="#aaaaaa" />
              </marker>
              <marker id="arrow-blue" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 0 L 10 5 L 0 10 z" fill="#3388ff" />
              </marker>
            </defs>

            <% @match.play_logs.where(set_number: current_set).each do |log| %>
              <% p_id = log.player_id.to_s %>
              <% if log.start_x.present? && log.start_y.present? && log.end_x.present? && log.end_y.present? && log.action_type != "ブロック" %>
                <%
                  arrow_color = case log.eval_detail
                                when "◎" then "#ffeb3b"
                                when "✖️" then "#3388ff"
                                else "#aaaaaa"
                                end
                  marker_id = case log.eval_detail
                              when "◎" then "arrow-yellow"
                              when "✖️" then "arrow-blue"
                              else "arrow-gray"
                              end
                %>
                <line class="log-element log-player-<%= p_id %>" data-player-id="<%= p_id %>" x1="<%= log.start_x %>%" y1="<%= log.start_y %>%" x2="<%= log.end_x %>%" y2="<%= log.end_y %>%"
                      stroke="<%= arrow_color %>" stroke-width="3" stroke-dasharray="<%= log.action_type.include?('スパイク') ? 'none' : '4,4' %>"
                      marker-end="url(#<%= marker_id %>)" />
              <% end %>
            <% end %>

            <line id="preview_line" x1="0" y1="0" x2="0" y2="0" stroke="#ffffff" stroke-width="3.5" marker-end="url(#arrow-white)" style="display: none;" />
          </svg>
        </div>

        <div id="own_serve_area" onclick="selectZone('サーブ')" style="background: #444; color: #ffeb3b; padding: 6px; margin-top: 5px; border-radius: 4px; cursor: pointer; font-size: 0.75em; font-weight: bold; border: 2px solid transparent;">
          ▼ エンドライン (タップ)
        </div>
      </div>

      <div id="status_bar" style="margin-top: 6px; background: #333; padding: 5px; border-radius: 4px; color: #00e676; font-size: 0.75em; font-weight: bold;">
        背番号タップでコース表示（長押しで変更・削除）
      </div>
    </div>
  </div>

  <!-- 隠しフォーム (データ入力用) -->
  <%= form_with model: [@team, @match, PlayLog.new], local: true, id: "play_log_form" do |f| %>
    <%= f.hidden_field :set_number, value: current_set %>
    <%= f.hidden_field :player_id, id: "form_player_id" %>
    <%= f.hidden_field :action_type, id: "form_action_type" %>
    <%= f.hidden_field :eval_detail, id: "form_eval_detail" %>
    <%= f.hidden_field :result, id: "form_result" %>
    <%= f.hidden_field :start_x, id: "form_start_x" %>
    <%= f.hidden_field :start_y, id: "form_start_y" %>
    <%= f.hidden_field :end_x, id: "form_end_x" %>
    <%= f.hidden_field :end_y, id: "form_end_y" %>
  <% end %>

  <!-- 削除専用隠しフォーム -->
  <form id="delete_log_form" method="post" style="display: none;">
    <input type="hidden" name="_method" value="delete">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  </form>

  <!-- 集計テーブル -->
  <div style="margin-top: 20px; background: white; padding: 10px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); overflow-x: auto;">
    <h3 style="margin-top: 0; border-bottom: 2px solid #007bff; padding-bottom: 5px; color: #333; font-size: 1.0em;">📊 選手別スタッツ (第 <%= current_set %> セット)</h3>
    <table style="width: 100%; border-collapse: collapse; margin-top: 6px; text-align: center; font-size: 0.85em; min-width: 500px;">
      <thead>
        <tr style="background: #007bff; color: white;">
          <th style="padding: 6px; border: 1px solid #ddd; text-align: left;">選手名</th>
          <th style="padding: 6px; border: 1px solid #ddd;">① サーブ効果率</th>
          <th style="padding: 6px; border: 1px solid #ddd;">② スパイク決定率</th>
          <th style="padding: 6px; border: 1px solid #ddd;">③ レセプション成功率</th>
          <th style="padding: 6px; border: 1px solid #ddd;">④ ブロック決定数</th>
        </tr>
      </thead>
      <tbody>
        <% @team.players.where.not(name: [nil, ""]).each do |player| %>
          <% p_logs = @match.play_logs.where(set_number: current_set, player_id: player.id) %>
          <% 
            s_logs = p_logs.where(action_type: "サーブ")
            s_total = s_logs.count
            s_rate = s_total > 0 ? (((s_logs.where(eval_detail: "◎").count * 100.0) + (s_logs.where(eval_detail: "◯").count * 25.0) - (s_logs.where(eval_detail: "✖️").count * 25.0)) / s_total) : 0.0

            k_logs = p_logs.where(action_type: "スパイク")
            k_total = k_logs.count
            k_kills = k_logs.where(eval_detail: "◎").count
            k_rate = k_total > 0 ? ((k_kills.to_f / k_total) * 100.0) : 0.0

            r_logs = p_logs.where(action_type: "レセプション")
            r_total = r_logs.count
            r_rate = r_total > 0 ? (((r_logs.where(eval_detail: "◎").count * 100.0) + (r_logs.where(eval_detail: "◯").count * 50.0)) / r_total) : 0.0

            b_kills = p_logs.where(action_type: "ブロック", eval_detail: "◎").count
          %>
          <% if p_logs.any? || player.is_starter? %>
            <tr style="border-bottom: 1px solid #eee;">
              <td style="padding: 6px; border: 1px solid #ddd; text-align: left; font-weight: bold;">
                <%= player.number %> <%= player.name %> <span style="font-size: 0.75em; color: #666;">(<%= player.position %>)</span>
              </td>
              <td style="padding: 6px; border: 1px solid #ddd; font-weight: bold; color: #007bff;"><%= sprintf("%.1f", s_rate) %>% <span style="font-size: 0.7em; color: #888;">(<%= s_total %>本)</span></td>
              <td style="padding: 6px; border: 1px solid #ddd; font-weight: bold; color: #28a745;"><%= sprintf("%.1f", k_rate) %>% <span style="font-size: 0.7em; color: #888;">(<%= k_kills %>/<%= k_total %>本)</span></td>
              <td style="padding: 6px; border: 1px solid #ddd; font-weight: bold; color: #6f42c1;"><%= sprintf("%.1f", r_rate) %>% <span style="font-size: 0.7em; color: #888;">(<%= r_total %>本)</span></td>
              <td style="padding: 6px; border: 1px solid #ddd; font-weight: bold; color: #fd7e14; font-size: 1.0em;"><%= b_kills %> 本</td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- スコア入力エリア -->
  <div style="margin-top: 15px; background: #f8f9fa; border: 2px solid #007bff; padding: 12px; border-radius: 8px;">
    <h4 style="margin: 0 0 8px 0; color: #007bff; font-size: 0.95em;">🏁 第 <%= current_set %> セット 最終スコア入力・終了</h4>
    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
      <div>
        <label style="font-size: 0.8em; font-weight: bold; color: #333;"><%= @team.name %>:</label>
        <input type="number" id="own_set_score" placeholder="25" style="width: 50px; padding: 4px; border: 1px solid #ccc; border-radius: 4px; font-weight: bold; text-align: center; font-size: 1.0em;">
      </div>
      <div style="font-weight: bold; font-size: 1.1em; color: #666;">-</div>
      <div>
        <label style="font-size: 0.8em; font-weight: bold; color: #333;"><%= @match.opponent_name %>:</label>
        <input type="number" id="opp_set_score" placeholder="23" style="width: 50px; padding: 4px; border: 1px solid #ccc; border-radius: 4px; font-weight: bold; text-align: center; font-size: 1.0em;">
      </div>
      <button type="button" id="finish_set_btn" onclick="finishSet(<%= current_set %>)" style="padding: 6px 14px; background: #dc3545; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 0.85em;">
        第 <%= current_set %> セット終了
      </button>
    </div>
  </div>
</div>

<!-- 選手交代/非表示用モーダル -->
<div id="player_swap_modal" class="modal-overlay">
  <div class="modal-content">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #555; padding-bottom: 8px; margin-bottom: 12px;">
      <h3 style="margin: 0; font-size: 1.0em; color: #ffeb3b;">🔄 選手変更・削除</h3>
      <button type="button" onclick="closeSwapModal()" style="background: none; border: none; color: #aaa; font-size: 1.2em; cursor: pointer;">✕</button>
    </div>
    <p style="font-size: 0.8em; margin: 0 0 10px 0; color: #ddd;">
      対象: <strong id="target_player_label" style="color: #00e676;"></strong>
    </p>

    <!-- 非表示（削除）ボタン -->
    <button type="button" onclick="removeCurrentPlayerButton()" style="width: 100%; padding: 8px; background: #dc3545; color: white; border: none; border-radius: 5px; font-weight: bold; font-size: 0.85em; cursor: pointer; margin-bottom: 10px;">
      ❌ このボタンを非表示（削除）にする
    </button>
    
    <div style="font-size: 0.75em; color: #aaa; margin-bottom: 6px;">別の選手へ変更:</div>
    <div style="max-height: 180px; overflow-y: auto; display: flex; flex-direction: column; gap: 6px;">
      <% @team.players.where.not(name: [nil, ""]).each do |p| %>
        <button type="button" onclick="executeSwap('<%= p.id %>', '<%= p.number %>', '<%= p.name %>', '<%= p.position %>')"
                style="width: 100%; text-align: left; padding: 8px 10px; background: #333; color: white; border: 1px solid #555; border-radius: 5px; font-size: 0.85em; cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
          <span><strong><%= p.number %></strong> <%= p.name %></span>
          <span style="font-size: 0.75em; color: #aaa;">(<%= p.position %>)</span>
        </button>
      <% end %>
    </div>
    
    <div style="margin-top: 12px; text-align: right;">
      <button type="button" onclick="closeSwapModal()" style="padding: 6px 12px; background: #555; color: white; border: none; border-radius: 4px; font-size: 0.8em; cursor: pointer;">キャンセル</button>
    </div>
  </div>
</div>

<!-- 控え選手追加用モーダル -->
<div id="add_player_modal" class="modal-overlay">
  <div class="modal-content">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #555; padding-bottom: 8px; margin-bottom: 12px;">
      <h3 style="margin: 0; font-size: 1.0em; color: #007bff;">＋ 選手ボタンの追加</h3>
      <button type="button" onclick="closeAddPlayerModal()" style="background: none; border: none; color: #aaa; font-size: 1.2em; cursor: pointer;">✕</button>
    </div>
    <p style="font-size: 0.8em; margin: 0 0 10px 0; color: #ddd;">
      入力パネルに追加する選手を選択してください。
    </p>
    <div style="max-height: 220px; overflow-y: auto; display: flex; flex-direction: column; gap: 6px;">
      <% @team.players.where.not(name: [nil, ""]).each do |p| %>
        <button type="button" onclick="addNewPlayerButton('<%= p.id %>', '<%= p.number %>', '<%= p.name %>', '<%= p.position %>')"
                style="width: 100%; text-align: left; padding: 8px 10px; background: #333; color: white; border: 1px solid #555; border-radius: 5px; font-size: 0.85em; cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
          <span><strong><%= p.number %></strong> <%= p.name %></span>
          <span style="font-size: 0.75em; color: #aaa;">(<%= p.position %>)</span>
        </button>
      <% end %>
    </div>
    <div style="margin-top: 12px; text-align: right;">
      <button type="button" onclick="closeAddPlayerModal()" style="padding: 6px 12px; background: #555; color: white; border: none; border-radius: 4px; font-size: 0.8em; cursor: pointer;">キャンセル</button>
    </div>
  </div>
</div>

<script>
  let isLocked = false;
  let activePlayerId = null;
  let selectedMode = null;

  let pressTimer = null;
  let currentSwapTargetBtn = null;

  // 1件削除用の安全な送信処理
  function deleteLastLog(deleteUrl) {
    if (confirm("直前の記録を取り消しますか？")) {
      const deleteForm = document.getElementById('delete_log_form');
      deleteForm.action = deleteUrl;
      sessionStorage.setItem('match_show_scroll_pos', window.scrollY);
      deleteForm.submit();
    }
  }

  // 選手ボタンイベント処理
  function setupPlayerButtonEvents(btn) {
    let pressStartTime = 0;

    const startPress = (e) => {
      pressStartTime = Date.now();
      clearTimeout(pressTimer);
      pressTimer = setTimeout(() => {
        openSwapModal(btn);
      }, 400);
    };

    const cancelPress = () => {
      clearTimeout(pressTimer);
    };

    btn.onmousedown = startPress;
    btn.ontouchstart = startPress;

    btn.onmouseup = cancelPress;
    btn.onmouseleave = cancelPress;
    btn.ontouchend = cancelPress;
    btn.ontouchcancel = cancelPress;
  }

  function onPlayerClick(btn) {
    togglePlayerSelect(btn);
  }

  function openSwapModal(btn) {
    currentSwapTargetBtn = btn;
    const pNum = btn.getAttribute('data-player-number');
    const pName = btn.getAttribute('data-player-name');
    const pPos = btn.getAttribute('data-player-pos');
    document.getElementById('target_player_label').innerText = pNum + " " + pName + " (" + pPos + ")";
    document.getElementById('player_swap_modal').style.display = 'flex';
  }

  function closeSwapModal() {
    document.getElementById('player_swap_modal').style.display = 'none';
    currentSwapTargetBtn = null;
  }

  function removeCurrentPlayerButton() {
    if (currentSwapTargetBtn) {
      currentSwapTargetBtn.remove();
      resetPlayerFilter();
      closeSwapModal();
    }
  }

  function openAddPlayerModal() {
    document.getElementById('add_player_modal').style.display = 'flex';
  }

  function closeAddPlayerModal() {
    document.getElementById('add_player_modal').style.display = 'none';
  }

  function getPosColors(pos) {
    let bgColor = "#ffffff";
    let textColor = "#222222";
    if (pos === "S") { bgColor = "#ffeb3b"; textColor = "#222222"; }
    else if (pos === "L") { bgColor = "#28a745"; textColor = "#ffffff"; }
    else if (pos === "W") { bgColor = "#ffffff"; textColor = "#222222"; }
    else if (pos === "M" || pos === "MB") { bgColor = "#7bc043"; textColor = "#ffffff"; }
    else if (pos === "OP") { bgColor = "#fd7e14"; textColor = "#ffffff"; }
    return { bgColor, textColor };
  }

  function executeSwap(newId, newNumber, newName, newPos) {
    if (!currentSwapTargetBtn) return;
    const colors = getPosColors(newPos);

    currentSwapTargetBtn.setAttribute('data-player-id', newId);
    currentSwapTargetBtn.setAttribute('data-player-number', newNumber);
    currentSwapTargetBtn.setAttribute('data-player-name', newName);
    currentSwapTargetBtn.setAttribute('data-player-pos', newPos);
    currentSwapTargetBtn.setAttribute('title', newNumber + " " + newName + " (" + newPos + ")");
    currentSwapTargetBtn.innerText = newNumber;
    currentSwapTargetBtn.style.background = colors.bgColor;
    currentSwapTargetBtn.style.color = colors.textColor;

    resetPlayerFilter();
    closeSwapModal();
  }

  function addNewPlayerButton(id, number, name, pos) {
    const container = document.getElementById('player_buttons_container');
    const colors = getPosColors(pos);

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'player-btn';
    btn.setAttribute('data-player-id', id);
    btn.setAttribute('data-player-number', number);
    btn.setAttribute('data-player-name', name);
    btn.setAttribute('data-player-pos', pos);
    btn.setAttribute('onclick', 'onPlayerClick(this)');
    btn.setAttribute('oncontextmenu', 'return false;');
    btn.setAttribute('title', number + " " + name + " (" + pos + ")");
    btn.style.cssText = `width: 60px; height: 34px; background: ${colors.bgColor}; color: ${colors.textColor}; border: 3px solid transparent; border-radius: 5px; font-weight: bold; font-size: 0.95em; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s;`;
    btn.innerText = number;

    setupPlayerButtonEvents(btn);
    container.appendChild(btn);
    closeAddPlayerModal();
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.player-btn').forEach(btn => {
      setupPlayerButtonEvents(btn);
    });

    const scrollPos = sessionStorage.getItem('match_show_scroll_pos');
    if (scrollPos) {
      window.scrollTo(0, parseInt(scrollPos, 10));
      sessionStorage.removeItem('match_show_scroll_pos');
    }
  });

  function saveScrollPositionAndSubmit() {
    sessionStorage.setItem('match_show_scroll_pos', window.scrollY);
    document.getElementById('play_log_form').submit();
  }

  function togglePlayerSelect(btn) {
    const targetPlayerId = btn.getAttribute('data-player-id');
    const playerNumName = btn.getAttribute('data-player-number') + " " + btn.getAttribute('data-player-name');

    if (activePlayerId === targetPlayerId) {
      resetPlayerFilter();
    } else {
      activePlayerId = targetPlayerId;

      document.querySelectorAll('.player-btn').forEach(b => {
        b.style.borderColor = 'transparent';
        b.style.boxShadow = 'none';
      });

      btn.style.borderColor = '#00e676';
      btn.style.boxShadow = '0 0 10px #00e676';

      document.querySelectorAll('.log-element').forEach(el => {
        const elPlayerId = el.getAttribute('data-player-id');
        if (elPlayerId === targetPlayerId) {
          el.style.display = 'block';
        } else {
          el.style.display = 'none';
        }
      });

      updateStatus("背番号 " + playerNumName + " 選択中（長押しで変更・削除）");
    }
  }

  function resetPlayerFilter() {
    activePlayerId = null;
    document.querySelectorAll('.player-btn').forEach(b => {
      b.style.borderColor = 'transparent';
      b.style.boxShadow = 'none';
    });
    document.querySelectorAll('.log-element').forEach(el => {
      el.style.display = 'block';
    });
    updateStatus(isLocked ? "🔒 入力終了（全選手のコース表示中）" : "全選手のコースを表示中");
  }

  function selectZone(mode) {
    if (isLocked) return;
    selectedMode = mode;
    
    document.getElementById('opp_serve_area').style.borderColor = (mode === 'レセプション') ? '#ffeb3b' : 'transparent';
    document.getElementById('own_serve_area').style.borderColor = (mode === 'サーブ') ? '#ffeb3b' : 'transparent';

    updateStatus("【" + mode + "】を選択中 ➔ 左側の評価ボタンを選択してください");
  }

  function finishSet(setNum) {
    const ownScore = document.getElementById('own_set_score').value;
    const oppScore = document.getElementById('opp_set_score').value;

    if (!ownScore || !oppScore) {
      alert("自チームおよび相手チームのスコアを入力してください。");
      return;
    }

    isLocked = true;

    document.querySelectorAll('.record-btn').forEach(btn => {
      btn.disabled = true;
      btn.style.opacity = '0.3';
      btn.style.cursor = 'not-allowed';
    });

    const finishBtn = document.getElementById('finish_set_btn');
    finishBtn.disabled = true;
    finishBtn.style.background = '#6c757d';
    finishBtn.innerText = "第 " + setNum + " セット終了済み";

    updateStatus("🔒 入力終了：背番号タップで各選手のコースを確認できます");
    alert("第 " + setNum + " セットを終了しました (" + ownScore + " - " + oppScore + ")。");
  }

  let isDrawing = false;
  let startPos = { x: null, y: null };
  let endPos = { x: null, y: null };

  const court = document.getElementById('court_canvas');
  const previewLine = document.getElementById('preview_line');

  function getCoords(e) {
    const rect = court.getBoundingClientRect();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    return {
      x: (((clientX - rect.left) / rect.width) * 100).toFixed(1),
      y: (((clientY - rect.top) / rect.height) * 100).toFixed(1)
    };
  }

  function startDrag(e) {
    if (isLocked) return;
    if (e.touches && e.touches.length > 1) {
      isDrawing = false;
      previewLine.style.display = 'none';
      return;
    }

    if (e.touches && e.touches.length === 1) {
      if (e.cancelable) e.preventDefault();
    }

    isDrawing = true;
    selectedMode = null;
    document.getElementById('opp_serve_area').style.borderColor = 'transparent';
    document.getElementById('own_serve_area').style.borderColor = 'transparent';

    startPos = getCoords(e);
    endPos = startPos;

    previewLine.setAttribute('x1', startPos.x + '%');
    previewLine.setAttribute('y1', startPos.y + '%');
    previewLine.setAttribute('x2', startPos.x + '%');
    previewLine.setAttribute('y2', startPos.y + '%');
    previewLine.style.display = 'block';
  }

  function moveDrag(e) {
    if (isLocked || !isDrawing) return;

    if (e.touches && e.touches.length > 1) {
      isDrawing = false;
      previewLine.style.display = 'none';
      return;
    }

    if (e.touches && e.touches.length === 1) {
      if (e.cancelable) e.preventDefault();
    }

    endPos = getCoords(e);
    previewLine.setAttribute('x2', endPos.x + '%');
    previewLine.setAttribute('y2', endPos.y + '%');

    const isOpponentStart = startPos.y !== null && parseFloat(startPos.y) < 50;
    const attackerType = isOpponentStart ? "【相手スパイク】" : "【自チームスパイク】";
    updateStatus(attackerType + " 描画中 ➔ 評価ボタンをタップ");
  }

  function endDrag(e) {
    if (isLocked || !isDrawing) return;
    isDrawing = false;
  }

  court.addEventListener('mousedown', startDrag);
  window.addEventListener('mousemove', moveDrag);
  window.addEventListener('mouseup', endDrag);

  court.addEventListener('touchstart', startDrag, { passive: false });
  window.addEventListener('touchmove', moveDrag, { passive: false });
  window.addEventListener('touchend', endDrag);

  function updateStatus(msg) {
    document.getElementById('status_bar').innerText = msg;
  }

  function submitBlockKill() {
    if (isLocked) return;
    if (!activePlayerId) {
      alert("ブロックを記録するには、まず左側の選手ボタンを選択してください。");
      return;
    }

    document.getElementById('form_player_id').value = activePlayerId;
    document.getElementById('form_action_type').value = "ブロック";
    document.getElementById('form_eval_detail').value = "◎";
    document.getElementById('form_result').value = "ブロック決定";
    document.getElementById('form_start_x').value = "";
    document.getElementById('form_start_y').value = "";
    document.getElementById('form_end_x').value = "";
    document.getElementById('form_end_y').value = "";

    saveScrollPositionAndSubmit();
  }

  function submitLog(evalSymbol, resultStr) {
    if (isLocked) return;

    let actionType = "スパイク";
    const isOpponentSpike = (startPos.y !== null && parseFloat(startPos.y) < 50.0);

    if (selectedMode === "サーブ") {
      actionType = "サーブ";
    } else if (selectedMode === "レセプション") {
      actionType = "レセプション";
    } else if (isOpponentSpike) {
      actionType = "相手スパイク";
    }

    if (!isOpponentSpike && !activePlayerId) {
      alert("記録するには、まず左側の選手（背番号）を選択してください。");
      return;
    }

    document.getElementById('form_player_id').value = isOpponentSpike ? "" : activePlayerId;
    document.getElementById('form_action_type').value = actionType;
    document.getElementById('form_eval_detail').value = evalSymbol;
    document.getElementById('form_result').value = resultStr;

    if (selectedMode === "サーブ" || selectedMode === "レセプション") {
      document.getElementById('form_start_x').value = "";
      document.getElementById('form_start_y').value = "";
      document.getElementById('form_end_x').value = "";
      document.getElementById('form_end_y').value = "";
    } else if (startPos.x !== null && startPos.y !== null) {
      document.getElementById('form_start_x').value = startPos.x;
      document.getElementById('form_start_y').value = startPos.y;
      document.getElementById('form_end_x').value = endPos.x;
      document.getElementById('form_end_y').value = endPos.y;
    }

    saveScrollPositionAndSubmit();
  }
</script>

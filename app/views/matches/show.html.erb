<% current_set = params[:set_number].present? ? params[:set_number].to_i : 1 %>

<div style="max-width: 950px; margin: 30px auto; padding: 20px; font-family: sans-serif;">
  <!-- ヘッダー情報 -->
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #333; padding-bottom: 10px;">
    <h2>🏐 <%= @team.name %> vs <%= @match.opponent_name %></h2>
    <span style="color: #666; font-weight: bold;"><%= @match.match_date %>（全<%= @match.total_sets %>セット）</span>
  </div>

  <div style="margin-top: 15px; margin-bottom: 20px;">
    <%= link_to "← 試合一覧に戻る", team_matches_path(@team), style: "color: #007bff; text-decoration: none;" %>
  </div>

  <!-- セット切り替えタブ -->
  <div style="margin-bottom: 25px; display: flex; gap: 10px;">
    <% (1..@match.total_sets).each do |s| %>
      <%= link_to "第 #{s} セット", team_match_path(@team, @match, set_number: s), style: "padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: bold; #{s == current_set ? 'background: #007bff; color: white;' : 'background: #e9ecef; color: #333;'}" %>
    <% end %>
  </div>

  <!-- 入力フォームエリア -->
  <div style="background: #f8f9fa; border: 1px solid #dee2e6; padding: 20px; border-radius: 8px; margin-bottom: 30px;">
    <h3 style="margin-top: 0; margin-bottom: 15px;">📝 プレイログ記録 (第 <%= current_set %> セット)</h3>

    <%= form_with model: [@team, @match, PlayLog.new], local: true do |f| %>
      <%= f.hidden_field :set_number, value: current_set %>

      <div style="display: flex; gap: 15px; flex-wrap: wrap; align-items: flex-end;">
        <div style="flex: 1; min-width: 150px;">
          <%= f.label :player_id, "選手", style: "font-weight: bold; display: block; margin-bottom: 5px;" %>
          <%= f.collection_select :player_id, @team.players.where.not(name: [nil, ""]), :id, ->(p) { "##{p.number} #{p.name} (#{p.position})" }, { prompt: "選手を選択" }, { required: true, style: "width: 100%; padding: 8px;" } %>
        </div>

        <div style="flex: 1; min-width: 130px;">
          <%= f.label :action_type, "アクション", style: "font-weight: bold; display: block; margin-bottom: 5px;" %>
          <%= f.select :action_type, ["サーブ", "レシーブ", "トス", "アタック", "ブロック"], { prompt: "種目" }, { required: true, style: "width: 100%; padding: 8px;" } %>
        </div>

        <div style="flex: 1; min-width: 130px;">
          <%= f.label :result, "結果", style: "font-weight: bold; display: block; margin-bottom: 5px;" %>
          <%= f.select :result, ["得点/成功", "継続/普通", "ミス/失点"], { prompt: "結果" }, { required: true, style: "width: 100%; padding: 8px;" } %>
        </div>

        <div>
          <%= f.submit "記録追加", style: "background: #28a745; color: white; border: none; padding: 9px 20px; border-radius: 6px; font-weight: bold; cursor: pointer;" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- 記録一覧表示 -->
  <h3>📊 第 <%= current_set %> セットのプレイ記録履歴</h3>
  <% logs = @match.play_logs.where(set_number: current_set).order(created_at: :desc) %>
  <% if logs.any? %>
    <table style="width: 100%; border-collapse: collapse; margin-top: 10px;">
      <thead>
        <tr style="background: #e9ecef; text-align: left;">
          <th style="padding: 10px; border: 1px solid #ccc;">選手</th>
          <th style="padding: 10px; border: 1px solid #ccc;">アクション</th>
          <th style="padding: 10px; border: 1px solid #ccc;">結果</th>
          <th style="padding: 10px; border: 1px solid #ccc;">時刻</th>
          <th style="padding: 10px; border: 1px solid #ccc; text-align: center;">操作</th>
        </tr>
      </thead>
      <tbody>
        <% logs.each do |log| %>
          <tr>
            <td style="padding: 10px; border: 1px solid #ccc;">#<%= log.player.number %> <%= log.player.name %></td>
            <td style="padding: 10px; border: 1px solid #ccc;"><%= log.action_type %></td>
            <td style="padding: 10px; border: 1px solid #ccc;">
              <% if log.result == "得点/成功" %>
                <span style="color: #28a745; font-weight: bold;">★ 得点/成功</span>
              <% elsif log.result == "ミス/失点" %>
                <span style="color: #dc3545; font-weight: bold;">✕ ミス/失点</span>
              <% else %>
                <span style="color: #6c757d;">◯ 継続</span>
              <% end %>
            </td>
            <td style="padding: 10px; border: 1px solid #ccc; font-size: 0.9em; color: #666;"><%= log.created_at.strftime("%H:%M:%S") %></td>
            <td style="padding: 10px; border: 1px solid #ccc; text-align: center;">
              <%= link_to "削除", team_match_play_log_path(@team, @match, log), data: { turbo_method: :delete }, style: "color: #dc3545; text-decoration: none;" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p style="color: #666; margin-top: 15px;">第 <%= current_set %> セットのプレイ記録はまだありません。</p>
  <% end %>
</div>
